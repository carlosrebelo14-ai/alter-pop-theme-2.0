{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Real Customers, Real Collections.
  Source: Wireframe_Alterpop_3_3.pdf 1a / 1b.
  Heading + a row of square customer-photo tiles + one review card
  (dot rating + short quote) sharing the same row/grid.
  Desktop: 5 cells (4 photos + 1 review). Mobile: photos scroll / wrap,
  review below.
{%- endcomment -%}

<section class="ap-ugc">
  <div class="ap-ugc__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ap-section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="ap-ugc__list" role="list">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'photo' -%}
            <li class="ap-ugc__cell ap-ugc__cell--photo" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', class: 'ap-ugc__img', sizes: '(min-width: 750px) 20vw, 60vw', widths: '320, 480, 640', alt: block.settings.alt | escape }}
              {%- else -%}
                <span class="ap-ugc__ph" aria-hidden="true"></span>
              {%- endif -%}
            </li>
          {%- when 'review' -%}
            <li class="ap-ugc__cell ap-ugc__cell--review" {{ block.shopify_attributes }}>
              {%- assign rating = block.settings.rating | default: 5 -%}
              <span class="ap-ugc__dots" role="img" aria-label="{{ rating }} / 5">
                {%- for i in (1..5) -%}
                  <span class="ap-ugc__dot{% if i <= rating %} is-filled{% endif %}"></span>
                {%- endfor -%}
              </span>
              {%- if block.settings.quote != blank -%}
                <blockquote class="ap-ugc__quote">{{ block.settings.quote | escape }}</blockquote>
              {%- endif -%}
              {%- if block.settings.attribution != blank -%}
                <p class="ap-ugc__by">{{ block.settings.attribution | escape }}</p>
              {%- endif -%}
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Real Customers",
  "tag": "section",
  "class": "section-ugc",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Customers, Real Collections" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "Rating" },
        { "type": "text", "id": "quote", "label": "Quote", "default": "box arrived spotless, ahead of schedule." },
        { "type": "text", "id": "attribution", "label": "Attribution" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real Customers",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
