{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — [Franchise] Archive editorial block.
  Source: Wireframe_Alterpop_3_3.pdf 1a / 1b.
  Desktop: 50/50 split — full-height editorial image LEFT, text block RIGHT
  (eyebrow "UNIVERSE" + heading + short paragraph + 3 square tiles + outlined
  "Explore the Archive -> Universe Room" button).
  Mobile: image on top, then the text block.

  The featured franchise is editorial (merchant-set). When the app provides
  the Franchise field it can auto-fill the heading/link; until then the
  heading default is a marked placeholder.
{%- endcomment -%}

<section class="ap-archive">
  <div class="ap-archive__inner">
    <div class="ap-archive__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'ap-archive__img', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt | default: section.settings.heading | escape }}
      {%- else -%}
        <div class="ap-archive__img ap-archive__img--placeholder" role="presentation"></div>
      {%- endif -%}
    </div>

    <div class="ap-archive__body">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ap-archive__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ap-archive__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ap-archive__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ap-archive__tiles" role="list">
          {%- for block in section.blocks -%}
            <li class="ap-archive__tile" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ap-archive__tile-img', sizes: '160px', widths: '160, 240, 320, 400', alt: '' }}
                {%- else -%}
                  <span class="ap-archive__tile-ph" aria-hidden="true"></span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="ap-archive__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          <span class="ap-archive__cta-label">{{ section.settings.cta_label | escape }}</span>
          {%- if section.settings.cta_sublabel != blank -%}
            <span class="ap-archive__cta-sub">{{ section.settings.cta_sublabel | escape }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Franchise Archive",
  "tag": "section",
  "class": "section-franchise-archive",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Editorial image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Universe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "[ Franquia ] Archive" },
    { "type": "textarea", "id": "text", "label": "Paragraph", "default": "Uma linha editorial curta sobre esta coleção de franquia." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore the Archive" },
    { "type": "text", "id": "cta_sublabel", "label": "CTA sub-label", "default": "→ Universe Room" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Franchise Archive", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
