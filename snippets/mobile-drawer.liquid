{% comment %}
  Alterpop — Mobile Drawer (header). Source of truth:
  Wireframe_Alterpop_3_3.pdf 5a / 6c.

  Structure + behaviour stay Dawn's <header-drawer> (global.js: focus trap,
  Escape, body scroll lock, open on --motion-transactional). We replace the
  content and (via assets/header.css) the visuals. section.settings.menu is
  NOT rendered — the admin menu is the old structure, shared with live.

  6c: "Universes is the first section in the hamburger drawer — a plain
  vertical list (NOT accordion), fully visible on open, scroll if needed."
  Each row = small square thumbnail + franchise name; then "View All
  Universes ->". Below: New Arrivals / Limited Editions & Exclusives /
  Gifts Under €25 / Outlet.

  BLOQUEADO: aguarda app — the franchise list. Same slot as the header
  (shop.metafields.alterpop.universes.value). Empty -> dev placeholder.
  No inference from tags / collections / custom.parent_collection.

  Accepts: show_country_selector, show_language_selector, show_social_links.
{% endcomment %}

{%- liquid
  assign curation_base = routes.collections_url

  assign ap_universes = shop.metafields.alterpop.universes.value
  assign ap_universes_is_placeholder = false
  if ap_universes == blank
    assign ap_universes_is_placeholder = true
    assign ph_titles = 'Star Wars,Demon Slayer,One Piece,Stranger Things,The Mandalorian,Attack on Titan' | split: ','
  endif
-%}

<header-drawer data-breakpoint="tablet">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <svg class="icon-hamburger" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <svg class="icon-close" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M4 4 16 16M16 4 4 16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </summary>

    <div id="menu-drawer" class="menu-drawer motion-reduce">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">

          <a href="{{ routes.root_url }}" class="menu-drawer__brand" aria-label="{{ shop.name | escape }}">
            {%- if settings.logo != blank -%}
              {{ settings.logo | image_url: width: 360 | image_tag: class: 'menu-drawer__brand-img', width: settings.logo_width, alt: shop.name | escape }}
            {%- else -%}
              {{- 'lockup-horizontal-ink.svg' | inline_asset_content -}}
            {%- endif -%}
          </a>

          <nav class="menu-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            <div class="menu-drawer__universes">
              <p class="menu-drawer__section-label">{{ 'sections.header.universes' | t }}</p>
              <ul class="menu-drawer__universes-list" role="list">
                {%- if ap_universes_is_placeholder -%}
                  {%- for title in ph_titles -%}
                    <li>
                      <a href="{{ routes.all_products_collection_url }}" class="menu-drawer__universe">
                        <span class="menu-drawer__universe-thumb menu-drawer__universe-thumb--ph" aria-hidden="true">{{ title | slice: 0, 1 }}</span>
                        <span class="menu-drawer__universe-name">{{ title }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  {%- for universe in ap_universes -%}
                    <li>
                      <a href="{{ universe.url }}" class="menu-drawer__universe">
                        <span class="menu-drawer__universe-thumb">
                          {%- if universe.image -%}
                            {{ universe.image | image_url: width: 80 | image_tag: loading: 'lazy', alt: universe.title | escape }}
                          {%- else -%}
                            <span class="menu-drawer__universe-thumb--ph" aria-hidden="true">{{ universe.title | slice: 0, 1 }}</span>
                          {%- endif -%}
                        </span>
                        <span class="menu-drawer__universe-name">{{ universe.title | escape }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>
              <a href="{{ curation_base }}" class="menu-drawer__viewall">
                {{- 'sections.header.view_all_universes' | t }} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

            <ul class="menu-drawer__menu list-menu" role="list">
              <li><a href="{{ curation_base }}/new-arrivals" class="menu-drawer__menu-item">{{ 'sections.header.new_arrivals' | t }}</a></li>
              <li><a href="{{ curation_base }}/limited-editions-exclusives" class="menu-drawer__menu-item">{{ 'sections.header.limited_editions' | t }}</a></li>
              <li><a href="{{ curation_base }}/gifts-under-25" class="menu-drawer__menu-item">{{ 'sections.header.gifts_outlet' | t }}</a></li>
            </ul>
          </nav>

          <div class="menu-drawer__utility-links">
            {%- if show_country_selector or show_language_selector -%}
              <div class="menu-drawer__localization header-localization">
                {%- if show_country_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">{{ 'localization.country_label' | t }}</h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
                {%- if show_language_selector -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">{{ 'localization.language_label' | t }}</h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if show_social_links -%}
              {%- render 'social-icons', class: 'list-social' -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
