{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Product rail (Phase 2). Wireframe 1b.
  A CURATED, LIMITED showcase — New Arrivals / Bestsellers.
  NOT the full catalog: no facets, no pagination, no "load more".
  Uses the ONE product card (snippets/product-card.liquid). No variant.
  Desktop: grid. Mobile: horizontal scroll rail.
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
  assign cols = section.settings.columns_desktop | default: 4
-%}

<section class="ap-rail" style="--ap-rail-cols: {{ cols }};">
  <div class="ap-rail__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="ap-rail__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.view_all_label != blank and coll != blank -%}
      <a class="ap-rail__viewall" href="{{ coll.url }}">{{ section.settings.view_all_label | escape }}</a>
    {%- endif -%}
  </div>

  {%- if coll != blank and coll.products_count > 0 -%}
    <ul class="ap-rail__list" role="list">
      {%- assign skip_rail_card_styles = false -%}
      {%- for product in coll.products limit: limit -%}
        <li>
          {%- render 'product-card',
            card_product: product,
            section_id: section.id,
            lazy_load: true,
            skip_styles: skip_rail_card_styles
          -%}
        </li>
        {%- assign skip_rail_card_styles = true -%}
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="ap-rail__empty">{{ 'sections.product_rail.empty' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product rail",
  "tag": "section",
  "class": "section-product-rail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show",
      "info": "Curated and limited — this rail is not a paginated catalog."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "View all"
    }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
