{{ 'footer.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Footer. Source of truth: Wireframe_Alterpop_3_3.pdf 1a / 1b.

  Structure:
    1. Collectors Club band — heading + note (left) + email + Join (right).
       Dawn {% form 'customer' %} logic kept (contact[tags]=newsletter,
       form.errors / form.posted_successfully?).
    2. Footer row —
       symbol-ink logo · "Visa · Mastercard · Apple Pay · Google Pay ·
       14-Day Returns" (plain text) · FAQ link
       ─────
       Legal   Terms & Conditions · Privacy Policy · Cookie Policy ·
               Complaints Book · Contact
       fine print (one line, dot-separated): legal name · NIF · address

  Fine print: legal name, NIF and fiscal address were NOT provided —
  clearly-marked placeholders. Full legal copy pending lawyer review.
  Link colour is gold-700 (#8A5E0F) per the wireframe — NOT Marigold
  (Marigold stays exclusive to purchase CTAs).
{%- endcomment -%}

<footer class="ap-footer">

  {%- if section.settings.newsletter_enable -%}
    <div class="ap-footer__club">
      <div class="ap-footer__club-inner page-width">
        <div class="ap-footer__club-copy">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="ap-footer__club-heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          <p class="ap-footer__club-note">{{ 'sections.footer.collectors_club_note' | t }}</p>
        </div>

        {%- form 'customer', id: 'ContactFooter', class: 'ap-footer__club-form newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ap-footer__field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus aria-invalid="true" aria-describedby="ContactFooter-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="ContactFooter-success"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="ap-footer__label" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <button type="submit" class="ap-btn ap-btn--secondary ap-footer__join" name="commit">{{ 'sections.footer.join' | t }}</button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message" id="ContactFooter-error">
              {{ 'icon-error.svg' | inline_asset_content }}
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3 class="newsletter-form__message newsletter-form__message--success" id="ContactFooter-success" tabindex="-1" autofocus>
              {{ 'icon-success.svg' | inline_asset_content }} {{ 'newsletter.success' | t }}
            </h3>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="ap-footer__main">
    <div class="ap-footer__main-inner page-width">
      <div class="ap-footer__row-top">
        <a href="{{ routes.root_url }}" class="ap-footer__logo" aria-label="{{ shop.name | escape }}">
          {{- 'symbol-ink.svg' | inline_asset_content -}}
        </a>
        {%- if section.settings.footer_meta != blank -%}
          <p class="ap-footer__meta">{{ section.settings.footer_meta | escape }}</p>
        {%- endif -%}
        {%- if section.settings.faq_url != blank -%}
          <a href="{{ section.settings.faq_url }}" class="ap-footer__link ap-footer__faq">{{ 'sections.footer.faq' | t }}</a>
        {%- endif -%}
      </div>

      <hr class="ap-footer__rule">

      {%- comment -%}
        TODO: confirmar handles — /pages/cookie-policy e /pages/contact não são
        políticas nativas do Shopify. Terms/Privacy usam /policies/*.
      {%- endcomment -%}
      <nav class="ap-footer__legal" aria-label="{{ 'sections.footer.legal_heading' | t }}">
        <span class="ap-footer__legal-label">{{ 'sections.footer.legal_heading' | t }}</span>
        <ul class="ap-footer__legal-list">
          <li><a class="ap-footer__link" href="/policies/terms-of-service">{{ 'sections.footer.terms' | t }}</a></li>
          <li><a class="ap-footer__link" href="/policies/privacy-policy">{{ 'sections.footer.privacy' | t }}</a></li>
          <li><a class="ap-footer__link" href="/pages/cookie-policy">{{ 'sections.footer.cookie_policy' | t }}</a></li>
          <li><a class="ap-footer__link" href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener noreferrer">{{ 'sections.footer.complaints_book' | t }}</a></li>
          <li><a class="ap-footer__link" href="/pages/contact">{{ 'sections.footer.contact' | t }}</a></li>
        </ul>
      </nav>

      {%- comment -%}
        FINE PRINT — legal seller identification, read from the global
        settings.legal_name / legal_tax_id / legal_address (2026-09-15
        briefing, review 2). Each segment renders only with a value; the
        whole line hides with all three blank (rule 0 — no placeholder
        reaches the customer). Values are the merchant's own to fill in.
      {%- endcomment -%}
      {%- liquid
        assign legal_parts = ''
        if settings.legal_name != blank
          assign legal_parts = legal_parts | append: settings.legal_name | escape
        endif
        if settings.legal_tax_id != blank
          if legal_parts != blank
            assign legal_parts = legal_parts | append: ' · '
          endif
          assign legal_parts = legal_parts | append: settings.legal_tax_id | escape
        endif
        if settings.legal_address != blank
          if legal_parts != blank
            assign legal_parts = legal_parts | append: ' · '
          endif
          assign legal_parts = legal_parts | append: settings.legal_address | escape
        endif
      -%}
      {%- if legal_parts != blank -%}
        <p class="ap-footer__fineprint">{{ legal_parts }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Collectors Club",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "text",
      "id": "footer_meta",
      "label": "Payments / returns line",
      "default": "Visa · Mastercard · Apple Pay · Google Pay · 14-Day Returns"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQ link"
    }
  ]
}
{% endschema %}
