{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Bestsellers. Source: Wireframe_Alterpop_3_3.pdf 1a / 1b.
  A RANKED numbered list (1..N). Mobile: rows (rank + thumb + title + meta +
  price). Desktop: columns (rank on top, image, title, meta, price).
  Meta line: FRANCHISE · dimension · "N sold this month".

  BLOQUEADO: aguarda app —
    - franchise:  product.metafields.alterpop.franchise (same slot as the card)
    - sold count: product.metafields.alterpop.sold_this_month
  Both are omitted when absent (no inference). Dimension is live
  (ociostock.dimensions). The rank is the curated collection order.
{%- endcomment -%}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show | default: 5
-%}

<section class="ap-best">
  <div class="ap-best__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ap-section-heading ap-best__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if coll != blank and coll.products_count > 0 -%}
      <ol class="ap-best__list">
        {%- for product in coll.products limit: limit -%}
          {%- liquid
            assign franchise = product.metafields.alterpop.franchise.value
            assign dimension = product.metafields.ociostock.dimensions.value
            assign sold = product.metafields.alterpop.sold_this_month.value
          -%}
          <li class="ap-best__item">
            <span class="ap-best__rank" aria-hidden="true">{{ forloop.index }}</span>
            <a class="ap-best__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ap-best__img', sizes: '(min-width: 750px) 18vw, 22vw', widths: '160, 240, 320, 400', alt: product.featured_media.alt | default: product.title | escape }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'ap-best__img ap-best__img--placeholder' }}
              {%- endif -%}
            </a>
            <div class="ap-best__body">
              <h3 class="ap-best__title">
                <a href="{{ product.url }}" class="ap-best__title-link">{{ product.title | escape }}</a>
              </h3>
              {%- comment -%}
                Meta: FRANCHISE · dimension · N sold this month.
                franchise + sold (metafields.alterpop.*) are BLOQUEADO — sold
                is shown as a MARKED placeholder (not omitted) so the ranked
                list keeps its visible justification. No inference.
              {%- endcomment -%}
              <p class="ap-best__meta">
                {%- if franchise != blank -%}{{ franchise | escape }}&nbsp;·&nbsp;{%- endif -%}
                {%- if dimension != blank -%}{{ dimension | escape }}&nbsp;·&nbsp;{%- endif -%}
                {%- if sold != blank -%}
                  {{ sold | escape }} {{ 'sections.bestsellers.sold_this_month' | t }}
                {%- else -%}
                  <span class="ap-best__ph">{{ 'sections.bestsellers.sold_placeholder' | t }}</span>
                {%- endif -%}
              </p>
              <p class="ap-best__price">{{ product.price | money }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- else -%}
      <p class="ap-empty">{{ 'sections.product_rail.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "tag": "section",
  "class": "section-bestsellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection (curated order = ranking)" },
    { "type": "range", "id": "products_to_show", "min": 3, "max": 10, "step": 1, "default": 5, "label": "Items to show" }
  ],
  "presets": [{ "name": "Bestsellers" }]
}
{% endschema %}
