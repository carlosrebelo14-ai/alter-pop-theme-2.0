{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- comment -%}
  Alterpop — Predictive Search results (AJAX section for the Search Overlay).
  Rendered by predictive-search.js into [data-predictive-search].
  Structure + visuals are ours (assets/search.css); JS hooks kept:
    #predictive-search-results[role=listbox],
    #predictive-search-results-groups-wrapper,
    li.predictive-search__list-item#predictive-search-option-* [role=option]
      (first child <a> = navigation target),
    #predictive-search-option-search-keywords + [data-predictive-search-search-for-text],
    [data-predictive-search-live-region-count-value][data-total-results],
    .predictive-search__loading-state.
  Product results use the ONE product card (snippets/product-card.liquid) —
  no variant. No Marigold.
{%- endcomment -%}
<div id="predictive-search-results" role="listbox">
  {%- if predictive_search.performed -%}
    {%- liquid
      assign suggestions_count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
      assign pages_count = predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
      assign first_column_results_size = suggestions_count | plus: pages_count
      assign products_count = predictive_search.resources.products.size
      assign total_results = products_count | plus: first_column_results_size
    -%}

    {%- if total_results > 0 -%}
      <div id="predictive-search-results-groups-wrapper">

        {%- if suggestions_count > 0 -%}
          <div class="predictive-search__group">
            <h2 id="predictive-search-queries" class="predictive-search__heading">
              {{- 'templates.search.suggestions' | t -}}
            </h2>
            <ul
              id="predictive-search-results-queries-list"
              class="predictive-search__results-list"
              role="group"
              aria-labelledby="predictive-search-queries"
            >
              {%- for query in predictive_search.resources.queries -%}
                <li
                  id="predictive-search-option-query-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ query.url }}" class="predictive-search__item" tabindex="-1">
                    <p class="predictive-search__item-heading" aria-label="{{ query.text | escape }}">
                      {{ query.styled_text }}
                    </p>
                  </a>
                </li>
              {%- endfor -%}
              {%- for collection in predictive_search.resources.collections -%}
                <li
                  id="predictive-search-option-collection-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ collection.url }}" class="predictive-search__item" tabindex="-1">
                    <p class="predictive-search__item-heading">{{ collection.title | escape }}</p>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if pages_count > 0 -%}
          <div class="predictive-search__group">
            <h2 id="predictive-search-pages" class="predictive-search__heading">
              {{- 'templates.search.pages' | t -}}
            </h2>
            <ul
              id="predictive-search-results-pages-list"
              class="predictive-search__results-list"
              role="group"
              aria-labelledby="predictive-search-pages"
            >
              {%- for page in predictive_search.resources.pages -%}
                <li
                  id="predictive-search-option-page-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ page.url }}" class="predictive-search__item" tabindex="-1">
                    <p class="predictive-search__item-heading">{{ page.title | escape }}</p>
                  </a>
                </li>
              {%- endfor -%}
              {%- for article in predictive_search.resources.articles -%}
                <li
                  id="predictive-search-option-article-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ article.url }}" class="predictive-search__item" tabindex="-1">
                    <p class="predictive-search__item-heading">{{ article.title | escape }}</p>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%}
          Compact list (thumbnail + title + price) — NOT the full product
          card. Decision taken in the absence of a wireframe page (recorded
          in CLAUDE.md): 8a lists the card as used in New Arrivals /
          Bestsellers / Universe Room / Gifts Under €25, not search.
        {%- endcomment -%}
        {%- if products_count > 0 -%}
          <div class="predictive-search__group">
            <h2 id="predictive-search-products" class="predictive-search__heading">
              {{- 'templates.search.products' | t -}}
            </h2>
            <ul
              id="predictive-search-results-products-list"
              class="predictive-search__results-list predictive-search__results-list--products"
              role="group"
              aria-labelledby="predictive-search-products"
            >
              {%- for product in predictive_search.resources.products -%}
                <li
                  id="predictive-search-option-product-{{ forloop.index }}"
                  class="predictive-search__list-item"
                  role="option"
                  aria-selected="false"
                >
                  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'search' | escape }}">
                    <a href="{{ product.url }}" class="ap-psr" tabindex="-1">
                      <span class="ap-psr__media">
                        {%- if product.featured_media -%}
                          <img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
                        {%- endif -%}
                      </span>
                      <span class="ap-psr__title">{{ product.title | escape }}</span>
                      <span class="ap-psr__price">{{ product.price | money }}</span>
                    </a>
                  </product-component>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

      </div>
    {%- else -%}
      {%- comment -%}
        No-results state (wireframe 5c). The "{N} pieces in {franchise}" line
        needs the Franchise field (BLOQUEADO) — omitted; generic helper +
        a way out instead.
      {%- endcomment -%}
      <div class="ap-search__noresults">
        <span class="ap-search__noresults-mark" aria-hidden="true">
          {{- 'symbol-ink.svg' | inline_asset_content -}}
        </span>
        <p class="ap-search__noresults-heading">
          {{ 'templates.search.no_results' | t: terms: predictive_search.terms }}
        </p>
        <p class="ap-search__noresults-hint">{{ 'templates.search.no_results_hint' | t }}</p>
        <a class="ap-search__noresults-cta" href="{{ routes.all_products_collection_url }}">
          {{- 'templates.search.browse_catalog' | t -}}
        </a>
      </div>
    {%- endif -%}

    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}

    <div id="predictive-search-option-search-keywords" class="predictive-search__search-for-button">
      <button
        class="predictive-search__item predictive-search__item--term"
        tabindex="-1"
        role="option"
        aria-selected="false"
      >
        <span data-predictive-search-search-for-text>
          {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
        </span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <span
      class="hidden"
      data-predictive-search-live-region-count-value
      data-total-results="{{ total_results }}"
    >
      {% liquid
        if total_results == 0
          echo 'templates.search.no_results' | t: terms: predictive_search.terms
        else
          echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
          if suggestions_count > 0
            echo 'templates.search.results_suggestions_with_count' | t: count: suggestions_count | append: ', '
          endif
          if pages_count > 0
            echo 'templates.search.results_pages_with_count' | t: count: pages_count | append: ', '
          endif
          if products_count > 0
            echo 'templates.search.results_products_with_count' | t: count: products_count
          endif
        endif
      %}
    </span>
  {%- endif -%}
</div>
