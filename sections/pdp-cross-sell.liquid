{{ 'pdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — PDP cross-sell. Wireframe 3a/3b: "COMPLETE THE [universe]
  COLLECTION", the free-shipping threshold line, then a rail of small cards.
  Reinforces the €50 threshold (same number as the homepage shipping bar).

  Universe/Franchise is BLOCKED -> the heading falls back to a generic word.
  Products come from the product's first collection (no clean franchise
  collection yet). Uses the ONE product card, compact.
{%- endcomment -%}

{%- liquid
  assign source = product.collections | first
  assign universe = product.metafields.alterpop.universe.value
-%}

{%- if source != blank and source.products.size > 1 -%}
  <section class="ap-xsell page-width" aria-labelledby="XSell-{{ section.id }}">
    <p class="ap-xsell__label type-label" id="XSell-{{ section.id }}">
      {%- if universe != blank -%}
        {{ 'sections.pdp.xsell_heading' | t: name: universe }}
      {%- else -%}
        {{ 'sections.pdp.xsell_heading_generic' | t }}
      {%- endif -%}
    </p>

    <p class="ap-xsell__threshold type-caption">
      {%- render 'free-shipping-line', threshold_amount: section.settings.threshold_amount -%}
    </p>

    {%- comment -%}
      BLOQUEADO: aguarda app — Franchise/Universe. With the field the row is
      the same-universe pieces; without it we show the product's collection
      and mark it so it doesn't read as a real recommendation.
    {%- endcomment -%}
    {%- if universe == blank -%}
      <p class="ap-xsell__ph-note type-caption">{{ 'sections.pdp.xsell_placeholder' | t }}</p>
    {%- endif -%}

    <ul class="ap-xsell__row" role="list">
      {%- assign shown = 0 -%}
      {%- for item in source.products -%}
        {%- if item.id != product.id and shown < 4 -%}
          {%- assign xsell_skip_styles = true -%}
          {%- if shown == 0 -%}{%- assign xsell_skip_styles = false -%}{%- endif -%}
          <li class="ap-xsell__item">
            {% render 'product-card',
              card_product: item,
              compact: true,
              lazy_load: true,
              skip_styles: xsell_skip_styles
            %}
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PDP cross-sell",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "number",
      "id": "threshold_amount",
      "label": "Free-shipping threshold",
      "default": 50,
      "info": "Match the homepage shipping bar."
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
