{% comment %}
  Alterpop — Search Overlay (header). Wireframe 5c.
  Full-width on mobile, centered panel on desktop.

  Structure + visuals are ours (assets/search.css, tokens.css only).
  Dawn behaviour kept intact:
    - <details-modal> (details-modal.js): focus trap into [tabindex="-1"],
      Escape, click-outside via .modal-overlay, body scroll lock, close button.
    - <predictive-search> / <search-form> (predictive-search.js / search-form.js):
      debounced fetch of ?section_id=predictive-search, keyboard nav, reset.
  Required hooks kept: input[type="search"], button[type="reset"],
    [data-predictive-search], .predictive-search-status, button[type="button"].
  No Marigold here.

  Accepts:
  - input_id: {String} id for the search input (required)
{% endcomment %}

<details-modal class="ap-search">
  <details>
    <summary
      class="ap-search__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <svg class="ap-search__icon-search" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.75"/>
        <path d="m14 14 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <svg class="ap-search__icon-close" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 5 15 15M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </summary>

    <div
      class="ap-search__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="ap-search__overlay modal-overlay"></div>

      <div class="ap-search__panel" tabindex="-1">
        <button
          type="button"
          class="ap-search__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 5 15 15M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </button>

        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="ap-search__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="ap-search__form">
        {%- endif -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="ap-search__form-inner">
            <div class="ap-search__field">
              <svg class="ap-search__field-btn" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.75"/>
                <path d="m14 14 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
              </svg>
              <input
                class="ap-search__input"
                id="{{ input_id }}"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <label class="ap-search__label" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
              <input type="hidden" name="options[prefix]" value="last">
              <button
                type="reset"
                class="ap-search__field-btn reset__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M5 5 15 15M15 5 5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </button>
              <button type="submit" class="ap-search__field-btn search__button" aria-label="{{ 'general.search.search' | t }}">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            {%- if settings.predictive_search_enabled -%}
              <div class="predictive-search" tabindex="-1" data-predictive-search>
                {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
              </div>
              <span class="predictive-search-status" role="status" aria-hidden="true"></span>
            {%- endif -%}
          </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>
