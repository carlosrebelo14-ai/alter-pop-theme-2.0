{{ 'pdp.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — PDP cross-sell. Wireframe 3a/3b: "COMPLETE THE [franchise]
  COLLECTION", the free-shipping threshold line, then a rail of small cards.
  Reinforces the €50 threshold (same number as the homepage shipping bar).

  Source is the product's Character metaobject (alterpop.character, first
  entry) and its `products` field — siblings that share that character. No
  fallback to product.collections; without a character the section hides.
{%- endcomment -%}

{%- liquid
  assign character = product.metafields.alterpop.character.value | first
  assign siblings = character.products.value

  capture franchise_name
    render 'ap-meta-text', value: product.metafields.alterpop.franchise.value
  endcapture
  assign franchise_name = franchise_name | strip
-%}

{%- if character != blank and siblings.size > 1 -%}
  <section class="ap-xsell page-width" aria-labelledby="XSell-{{ section.id }}">
    <p class="ap-xsell__label type-label" id="XSell-{{ section.id }}">
      {%- if franchise_name != blank -%}
        {{ 'sections.pdp.xsell_heading' | t: name: franchise_name }}
      {%- else -%}
        {{ 'sections.pdp.xsell_heading_generic' | t }}
      {%- endif -%}
    </p>

    {%- if settings.show_free_shipping -%}
      <p class="ap-xsell__threshold type-caption">
        {%- render 'free-shipping-line', threshold_amount: section.settings.threshold_amount -%}
      </p>
    {%- endif -%}

    <ul class="ap-xsell__row" role="list">
      {%- assign shown = 0 -%}
      {%- for pass in (1..2) -%}
        {%- for sibling in siblings -%}
          {%- if sibling.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if pass == 1 and sibling.available == false -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and sibling.available -%}{%- continue -%}{%- endif -%}
          {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
          {%- assign xsell_skip_styles = true -%}
          {%- if shown == 0 -%}{%- assign xsell_skip_styles = false -%}{%- endif -%}
          <li class="ap-xsell__item">
            {% render 'product-card',
              card_product: sibling,
              compact: true,
              lazy_load: true,
              skip_styles: xsell_skip_styles
            %}
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PDP cross-sell",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "number",
      "id": "threshold_amount",
      "label": "Free-shipping threshold",
      "default": 50,
      "info": "Match the homepage shipping bar."
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
