{% comment %}
  Alterpop — Product Card
  =======================
  The ONE product card for the whole theme. Replaces Dawn's `card-product`.
  Source of truth: Wireframe_Alterpop_3_3.pdf pages 8a / 8b.
  "Same card component used in New Arrivals, Bestsellers, Universe Room and
  Gifts Under €25 — conditional logic, not a new component."

  Anatomy (top -> bottom), per 8a/8b:
    image (1:1)                                    Limited: +8% image area
                                                   Sold Out: 70% opacity
    status line   Limited  -> "N In Stock" pill (outlined)
                  Sold Out -> "Sold Out" (plain text, no pill)
                  Available -> nothing
    metadata      FRANCHISE · LINE  (uppercase, muted) — omitted when absent
    title         (bold)
    dimension     "N cm" (muted) — its own line, below the title
    price
    CTA           Sold Out ONLY -> "Notify Me" (outlined). No CTA otherwise.

  Hover: image scale on --motion-transactional (DS microinteraction 1).

  Accepts:
  - card_product:  {Object}  Product. If blank, a placeholder card is rendered.
  - section_id:    {String}  Owning section id (unique element ids). Optional.
  - lazy_load:     {Boolean} Lazy-load the image. Default: true.
  - skip_styles:   {Boolean} Don't emit <link> to product-card.css. Default: false.
  - placeholder_image: {String} placeholder_svg name when there is no product.
  - compact:       {Boolean} image + title + price only (Gifts Under €25 grid,
                             wireframe 8a: "same component, conditional logic").
                             Default: false.
  - hide_franchise: {Boolean} Drop FRANCHISE from the metadata line (the
                             Universe Room is already one franchise —
                             wireframe 7a shows "Character · wave", not the
                             franchise). Line still renders on its own.
                             Default: false.
  - compare:       {Boolean} Render the "Compare" toggle (wireframe 9a/9b
                             Compare Drawer). Entry point EXCLUSIVE to the
                             Character / Line pages — never passed elsewhere.
                             Default: false.

  Presentation state is derived from a stock NUMBER already provided by the sync
  app (allowed client-side calc). Sync runs ~45 min so the number can be stale;
  copy here never promises real-time accuracy — the real check is add-to-cart
  on the PDP (Dawn handles it).
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- liquid
  assign uid = section_id | default: 'ap'
  assign img_loading = 'lazy'
  if lazy_load == false
    assign img_loading = 'eager'
  endif
-%}

{%- if card_product == blank -%}
  {%- comment -%} No product bound (onboarding / empty collage slot). {%- endcomment -%}
  <div class="ap-card ap-card--available" aria-hidden="true">
    <div class="ap-card__media-link">
      <div class="ap-card__media">
        {{ placeholder_image | default: 'product-1' | placeholder_svg_tag: 'ap-card__img ap-card__img--placeholder' }}
      </div>
    </div>
    <div class="ap-card__body">
      <h3 class="ap-card__title"><span class="ap-card__title-link">{{ 'onboarding.product_title' | t }}</span></h3>
      <p class="ap-card__price">{{ 1999 | money }}</p>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign variant = card_product.selected_or_first_available_variant
    assign is_tracked = false
    if variant.inventory_management != blank
      assign is_tracked = true
    endif
    assign qty = variant.inventory_quantity

    assign state = 'available'
    if card_product.available == false
      assign state = 'soldout'
    elsif is_tracked and qty > 0 and qty <= 10
      assign state = 'limited'
    endif

    # Dimension — live from the sync app.
    assign dimension = card_product.metafields.ociostock.dimensions.value

    # BLOQUEADO: aguarda app — Franchise + Line. Wired to the expected fields;
    # renders "FRANCHISE · LINE" (uppercase) above the title when present, and
    # is omitted entirely when absent (matches wireframe 8a: the metadata line
    # only shows on the item that has the data). NO inference from tags /
    # ociostock.licence / custom.parent_collection.
    assign franchise = card_product.metafields.alterpop.franchise.value
    assign line = card_product.metafields.alterpop.line.value

    # Universe Room: suppress the franchise half of the meta line. The Phase 1A
    # condition below is unchanged — with franchise blank it renders Line
    # alone, or nothing when both are blank.
    if hide_franchise
      assign franchise = ''
    endif

    assign title_id = 'ap-card-title-' | append: uid | append: '-' | append: card_product.id
  -%}

  <div class="ap-card ap-card--{{ state }}{% if compact %} ap-card--compact{% endif %}">
    <a class="ap-card__media-link" href="{{ card_product.url }}" aria-labelledby="{{ title_id }}">
      <div class="ap-card__media">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 800
            | image_tag:
              loading: img_loading,
              class: 'ap-card__img',
              widths: '165, 220, 280, 360, 480, 600, 800',
              sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 50vw',
              alt: ''
          }}
        {%- else -%}
          {{ placeholder_image | default: 'product-1' | placeholder_svg_tag: 'ap-card__img ap-card__img--placeholder' }}
        {%- endif -%}
      </div>
    </a>

    <div class="ap-card__body">
      {%- unless compact -%}
        {%- comment -%} status slot is always rendered so the grid stays flush {%- endcomment -%}
        <span class="ap-card__status">
          {%- if state == 'limited' -%}
            <span class="ap-card__stock">{{ 'products.card.in_stock' | t: count: qty }}</span>
          {%- elsif state == 'soldout' -%}
            <span class="ap-card__soldout">{{ 'products.card.sold_out' | t }}</span>
          {%- endif -%}
        </span>

        {%- if franchise != blank or line != blank -%}
          <p class="ap-card__meta">
            {%- if franchise != blank -%}{{ franchise | upcase | escape }}{%- endif -%}
            {%- if franchise != blank and line != blank -%} · {% endif -%}
            {%- if line != blank -%}{{ line | upcase | escape }}{%- endif -%}
          </p>
        {%- endif -%}
      {%- endunless -%}

      <h3 class="ap-card__title" id="{{ title_id }}">
        <a href="{{ card_product.url }}" class="ap-card__title-link">{{ card_product.title | escape }}</a>
      </h3>

      {%- unless compact -%}
        {%- if dimension != blank -%}
          <p class="ap-card__dim">{{ dimension | escape }}</p>
        {%- endif -%}
      {%- endunless -%}

      {%- comment -%} BLOQUEADO: aguarda app — badge "Premium Piece" (flag Impulse/Premium). {%- endcomment -%}

      <p class="ap-card__price">
        {%- if card_product.price_varies -%}
          <span class="ap-card__price-from">{{ 'products.card.price_from' | t }}</span>
        {%- endif -%}
        <span class="ap-card__price-current">{{ card_product.price | money }}</span>
        {%- if card_product.compare_at_price > card_product.price -%}
          <span class="ap-card__price-compare">{{ card_product.compare_at_price | money }}</span>
          <span class="ap-card__sr">{{ 'products.card.on_sale' | t }}</span>
        {%- endif -%}
      </p>

      {%- if state == 'soldout' and compact != true -%}
        <a href="{{ card_product.url }}" class="ap-btn ap-btn--secondary ap-card__cta" aria-describedby="{{ title_id }}">
          {{- 'products.card.notify_me' | t -}}
        </a>
      {%- endif -%}

      {%- comment -%}
        Compare toggle — Character / Line pages only (wireframe 9a/9b).
        Carries everything the drawer table needs so it never has to fetch.
        Manufacturer / License are BLOCKED -> empty attr -> "[ pending ]" cell.
      {%- endcomment -%}
      {%- if compare -%}
        {%- liquid
          assign cmp_weight = ''
          if variant.weight > 0
            assign cmp_weight = variant.weight | weight_with_unit: variant.weight_unit
          endif
          assign cmp_license = card_product.metafields.alterpop.license.value | default: card_product.metafields.ociostock.licence.value
          assign cmp_img = ''
          if card_product.featured_media
            assign cmp_img = card_product.featured_media | image_url: width: 160
          endif
        -%}
        <button
          type="button"
          class="ap-btn ap-btn--ghost ap-card__compare"
          data-compare-toggle
          data-compare-id="{{ card_product.id }}"
          data-compare-title="{{ card_product.title | escape }}"
          data-compare-url="{{ card_product.url }}"
          data-compare-image="{{ cmp_img | escape }}"
          data-compare-price="{{ card_product.price | money | strip_html | escape }}"
          data-compare-available="{{ card_product.available }}"
          data-compare-manufacturer="{{ card_product.metafields.alterpop.manufacturer.value | escape }}"
          data-compare-weight="{{ cmp_weight | escape }}"
          data-compare-dimensions="{{ dimension | escape }}"
          data-compare-license="{{ cmp_license | escape }}"
          aria-pressed="false"
        >
          {{- 'sections.catalogue.compare' | t -}}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
