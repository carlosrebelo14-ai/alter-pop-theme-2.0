{{ 'pdp.css' | asset_url | stylesheet_tag }}
{%- comment -%} Dawn's gallery + price CSS provide sizing/mechanics; pdp.css (loaded first, scoped .ap-pdp) restyles on top. {%- endcomment -%}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- unless product.has_only_default_variant -%}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- comment -%}
  Alterpop — PDP. Source of truth: Wireframe 3a (impulse mobile) / 3b (premium
  mobile) / 3c (desktop). "Keep Dawn's logic, throw away Dawn's visuals":
  the <product-info> wrapper, media gallery (media-gallery.js + zoom modal),
  <variant-selects>, <product-form> + product-form.js and <quantity-input>
  are all Dawn's, untouched. Layout and copy are ours.

  Two regimes, built whole (v3):
    impulse  — no tier badge, Tech Specs collapsed by default, reviews are
               a bare rating; page + Add to Cart use --motion-transactional.
    premium  — "Premium Piece" badge, fragile-handling notice, spec sheet
               ALWAYS visible and staggered in row-by-row (+40ms, editorial
               easing — the system's ONLY stagger), still-life gallery enters
               with --motion-editorial, reviews carry a count.

  Regime source: snippets/ap-tier.liquid, which reads
  product.metafields.alterpop.manufacturer_tier (four raw values —
  ARTISAN / SIGNATURE / COLLECTOR / CORE — mapped to two PDP regimes) and
  is the ONLY place that field is read. For development the regime can be
  forced with the section setting `force_tier` (templates/product.premium.json
  bakes force_tier: premium, so /products/x?view=premium previews it).

  Identity Block, FIXED order: Character Name / Line · Manufacturer · Year /
  Type · Height. Every field except Height is BLOCKED — rendered as a marked
  placeholder wired to the expected metafield, never inferred. Line only
  shows with 3+ pieces of that line (not computable yet -> shown when the
  field is present). The Line slot COLLAPSES when absent — Universe/Franchise
  is never a substitute.
{%- endcomment -%}

{%- liquid
  assign forced = section.settings.force_tier
  capture tier
    render 'ap-tier', product: product, force_tier: forced
  endcapture
  assign tier = tier | strip

  assign is_premium = false
  if tier == 'premium'
    assign is_premium = true
  endif

  capture ap_tier_label
    render 'ap-tier', product: product, output: 'label'
  endcapture
  assign ap_tier_label = ap_tier_label | strip

  assign product_form_id = 'product-form-' | append: section.id

  # --- Identity Block fields -------------------------------------------
  # Character still BLOCKED (no definition on the store — 0/8 coverage).
  # manufacturer reads product.vendor (real, 8/8 coverage) instead of the
  # never-defined alterpop.manufacturer. type reads alterpop.format (list,
  # 6/8 coverage) instead of the never-defined alterpop.collectible_type.
  # Year dropped entirely — no such field, no fallback.
  assign ap_character = product.metafields.alterpop.character.value
  assign ap_line = product.metafields.alterpop.line.value
  assign ap_manufacturer = product.vendor
  assign ap_type = product.metafields.alterpop.format.value

  assign ap_fragile = product.metafields.alterpop.fragile.value

  assign v = product.selected_or_first_available_variant
  assign qty = v.inventory_quantity
  assign is_tracked = false
  if v.inventory_management != blank
    assign is_tracked = true
  endif
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  class="ap-pdp ap-pdp--{{ tier }} section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    .section-{{ section.id }}-padding { padding-top: 20px; padding-bottom: 12px; }
    @media (min-width: 990px) { .section-{{ section.id }}-padding { padding-top: 36px; } }
  {%- endstyle -%}

  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    <div class="ap-pdp__inner page-width">

      {%- comment -%} Breadcrumb: Universe > [name]. Universe is BLOCKED -> generic parent. {%- endcomment -%}
      <nav class="ap-pdp__crumbs type-caption" aria-label="Breadcrumb">
        <a href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{- collection.title | default: 'Catalogue' | escape -}}
        </a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{{ product.title | escape | truncate: 40 }}</span>
      </nav>

      <div class="ap-pdp__grid">

        {%- comment -%}
          Gallery — Dawn's media-gallery.js + zoom modal. The `product
          product--thumbnail product--large` classes are what Dawn's
          section-main-product.css keys its desktop gallery rules off
          (single active slide + thumbnail strip); pdp.css neutralises the
          `.product` grid so it doesn't fight our two-column layout.
        {%- endcomment -%}
        <div class="ap-pdp__media product product--thumbnail product--large" data-ap-grid>
          {%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}
          {% render 'product-media-gallery', variant_images: variant_images %}
        </div>

        {%- comment -%} ---- Info column ---- {%- endcomment -%}
        <div class="ap-pdp__info">
          <section id="ProductInfo-{{ section.id }}" class="ap-pdp__info-inner">

            {%- if ap_tier_label != blank -%}
              {% # theme-check-disable TranslationKeyExists %}
              <p class="ap-pdp__badge type-label">{{ 'sections.pdp.tier_' | append: ap_tier_label | t }}</p>
              {% # theme-check-enable TranslationKeyExists %}
            {%- endif -%}

            {%- comment -%}
              Identity Block — fixed order, every line collapses on its own
              when blank (2026-09-15 briefing, section 2). Character stays
              BLOCKED (no store definition) — its slot renders nothing when
              absent, never falling back to the raw supplier title.
              product.title is a separate, always-real field — it is the
              page's actual <h1> and stays visible as its own subordinate
              identification line right under Character, never hidden: a
              PDP has to say what product it is even before Character
              exists. See CLAUDE.md "PDP regime + Identity Block fields".
            {%- endcomment -%}
            <div class="ap-pdp__identity">
              {%- if ap_character != blank -%}
                <p class="ap-pdp__name type-h2">
                  {%- render 'ap-meta-text', value: ap_character -%}
                </p>
              {%- endif -%}
              <h1 class="ap-pdp__title type-product-title">{{ product.title | escape }}</h1>

              {%- liquid
                assign id_mid = ''
                if ap_line != blank
                  capture id_mid
                    render 'ap-meta-text', value: ap_line
                  endcapture
                endif
                if ap_manufacturer != blank
                  capture id_manufacturer
                    render 'ap-meta-text', value: ap_manufacturer
                  endcapture
                  if id_mid != blank
                    assign id_mid = id_mid | append: ' · '
                  endif
                  assign id_mid = id_mid | append: id_manufacturer
                endif
              -%}
              {%- if id_mid != blank -%}
                <p class="ap-pdp__identity-line type-caption">{{ id_mid }}</p>
              {%- endif -%}

              {%- if ap_type != blank -%}
                <p class="ap-pdp__identity-line type-caption">
                  {%- render 'ap-meta-text', value: ap_type -%}
                </p>
              {%- endif -%}
            </div>

            {%- comment -%} ---- Price (Dawn snippet; product-info.js swaps #price-<id>) ---- {%- endcomment -%}
            {% render 'price',
              product: product,
              use_variant: true,
              show_compare_at_price: true,
              price_class: 'ap-pdp__price'
            %}

            {%- comment -%}
              Stock line. Wireframe 3a (impulse): the stock pill only — the
              dispatch line lives once, below Add to Cart. 3b (premium):
              stock + dispatch on one line, and again below Add to Cart.
            {%- endcomment -%}
            <p class="ap-pdp__availability type-caption">
              <span id="Inventory-{{ section.id }}" class="ap-pdp__stock" role="status">
                {%- if v.available == false -%}
                  {{ 'products.product.sold_out' | t }}
                {%- elsif is_tracked and qty > 0 and qty <= 10 -%}
                  {{ 'products.card.in_stock' | t: count: qty }}
                {%- elsif is_tracked and qty > 0 -%}
                  {{ 'sections.pdp.in_stock_generic' | t }}
                {%- endif -%}
              </span>
              {%- if is_premium -%}
                <span class="ap-pdp__dispatch">{{ 'general.delivery_estimate' | t }}</span>
              {%- endif -%}
            </p>

            {%- comment -%}
              ---- Fragile notice — depends ONLY on the per-SKU alterpop.fragile
              flag, never on the tier. While that field does not exist yet
              (BLOCKED) ap_fragile is always blank, so the notice stays hidden.
            {%- endcomment -%}
            {%- if ap_fragile -%}
              <p class="ap-pdp__fragile" role="note">
                <span class="ap-pdp__fragile-icon" aria-hidden="true">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'sections.pdp.fragile' | t }}
              </p>
            {%- endif -%}

            {%- comment -%} ---- Variant picker (inline <variant-selects>, Dawn contract) ---- {%- endcomment -%}
            {%- unless product.has_only_default_variant -%}
              <variant-selects
                id="variant-selects-{{ section.id }}"
                class="ap-pdp__variants"
                data-section="{{ section.id }}"
                data-url="{{ product.url }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-id="{{ product.id }}"
                data-currency-code="{{ cart.currency.iso_code }}"
              >
                {%- for option in product.options_with_values -%}
                  <fieldset class="js product-form__input product-form__input--pill ap-pdp__option">
                    <legend class="form__label type-label">{{ option.name | escape }}</legend>
                    {% render 'product-variant-options', product: product, option: option, picker_type: 'button' %}
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-selected-variant>
                  {{ product.selected_or_first_available_variant | json }}
                </script>
              </variant-selects>
            {%- endunless -%}

            {%- comment -%}
              Quantity — inline (not the shared quantity-input snippet, which
              is the CART version: name="updates[...]" and value 0). On the
              PDP the field is name="quantity", starts at 1, and posts with
              the add-to-cart form. QuantityInput (global.js) wires the +/-.
            {%- endcomment -%}
            {%- assign qrule_min = v.quantity_rule.min | default: 1 -%}
            {%- assign qrule_step = v.quantity_rule.increment | default: 1 -%}
            <div class="ap-pdp__qty">
              <label class="form__label type-label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity.label' | t }}
              </label>
              <quantity-input class="quantity">
                <button class="quantity__button" name="minus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                </button>
                <input
                  class="quantity__input"
                  type="number"
                  name="quantity"
                  id="Quantity-{{ section.id }}"
                  value="1"
                  min="{{ qrule_min }}"
                  {% if v.quantity_rule.max != null %}max="{{ v.quantity_rule.max }}"{% endif %}
                  step="{{ qrule_step }}"
                  data-min="{{ qrule_min }}"
                  form="{{ product_form_id }}"
                  aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
                >
                <button class="quantity__button" name="plus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                </button>
              </quantity-input>
            </div>

            {%- comment -%} ---- Add to Cart (Dawn <product-form>; styled as .ap-btn--primary; overshoot) ---- {%- endcomment -%}
            <div class="ap-pdp__atc">
              {% render 'buy-buttons',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id
              %}
              <p class="ap-pdp__dispatch-repeat type-caption">{{ 'general.delivery_estimate' | t }}</p>
            </div>

            {%- comment -%}
              ---- Spec sheet ---- Brand reads product.vendor (Category
              dropped — no clean field, alterpop.collectible_type never
              existed). License reads alterpop.license, out of contract —
              the row stays in the markup but renders nothing (rule 0)
              until that field exists.
            {%- endcomment -%}
            {%- liquid
              assign spec_sku = v.sku
              assign spec_brand = product.vendor
              assign spec_license = product.metafields.alterpop.license.value
              assign spec_ean = v.barcode
              assign spec_weight = v.weight
              assign spec_weight_unit = v.weight_unit
              assign spec_dims = product.metafields.ociostock.dimensions.value
            -%}

            <div class="ap-pdp__specs" data-tier="{{ tier }}">
              {%- if is_premium -%}
                <h2 class="ap-pdp__specs-heading type-h3">{{ 'sections.pdp.specifications' | t }}</h2>
                <dl class="ap-pdp__spec-table" id="ap-spec-table-{{ section.id }}">
                  {% render 'pdp-spec-row', label: 'sections.pdp.spec_brand', value: spec_brand, i18n: true %}
                  {% render 'pdp-spec-row', label: 'SKU', value: spec_sku %}
                  {% render 'pdp-spec-row', label: 'EAN', value: spec_ean %}
                  {%- if spec_weight > 0 -%}
                    {% assign weight_str = spec_weight | weight_with_unit: spec_weight_unit %}
                    {% render 'pdp-spec-row', label: 'sections.pdp.spec_weight', value: weight_str, i18n: true %}
                  {%- endif -%}
                  {% render 'pdp-spec-row', label: 'sections.pdp.spec_dimensions', value: spec_dims, i18n: true %}
                  {% render 'pdp-spec-row', label: 'sections.pdp.spec_license', value: spec_license, i18n: true %}
                </dl>
                <script src="{{ 'pdp-spec-stagger.js' | asset_url }}" defer="defer"></script>
              {%- else -%}
                <details class="ap-pdp__specs-details">
                  <summary class="ap-pdp__specs-summary type-h3">
                    {{ 'sections.pdp.tech_specs' | t }}
                    <span class="ap-pdp__specs-toggle" aria-hidden="true">+</span>
                  </summary>
                  <dl class="ap-pdp__spec-table">
                    {% render 'pdp-spec-row', label: 'sections.pdp.spec_brand', value: spec_brand, i18n: true %}
                    {% render 'pdp-spec-row', label: 'SKU', value: spec_sku %}
                    {% render 'pdp-spec-row', label: 'EAN', value: spec_ean %}
                    {% render 'pdp-spec-row', label: 'sections.pdp.spec_dimensions', value: spec_dims, i18n: true %}
                  </dl>
                </details>
              {%- endif -%}
            </div>

            {%- comment -%}
              Official licensing seal (premium). alterpop.license_supplier
              is out of contract — without it we can't name THIS product's
              licensor, so the whole block hides rather than showing a
              generic "Officially Licensed" claim or a placeholder.
            {%- endcomment -%}
            {%- if is_premium -%}
              {%- assign seal_supplier = product.metafields.alterpop.license_supplier.value -%}
              {%- if seal_supplier != blank -%}
                <div class="ap-pdp__seal" role="note">
                  <p class="ap-pdp__seal-line">
                    <span class="ap-pdp__seal-icon" aria-hidden="true">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    {{ 'sections.pdp.seal_by' | t: brand: seal_supplier }}
                  </p>
                </div>
              {%- endif -%}
            {%- endif -%}

          </section>
        </div>
      </div>
    </div>
  </product-component>

  <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pdp-atc.js' | asset_url }}" defer="defer"></script>
</product-info>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "force_tier",
      "label": "Force regime (development only)",
      "info": "The real regime comes from product.metafields.alterpop.manufacturer_tier via snippets/ap-tier.liquid. Use this to preview.",
      "options": [
        { "value": "none", "label": "Auto (metafield -> impulse)" },
        { "value": "impulse", "label": "Impulse" },
        { "value": "premium", "label": "Premium" }
      ],
      "default": "none"
    },
    { "type": "header", "content": "Gallery" },
    {
      "type": "select",
      "id": "gallery_layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "thumbnail", "label": "Thumbnails" },
        { "value": "thumbnail_slider", "label": "Thumbnail slider" }
      ],
      "default": "thumbnail",
      "label": "Desktop layout"
    },
    {
      "type": "select",
      "id": "media_size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large",
      "label": "Media size"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "options": [
        { "value": "show", "label": "Show" },
        { "value": "columns", "label": "Columns" },
        { "value": "hide", "label": "Hide" }
      ],
      "default": "show",
      "label": "Mobile thumbnails"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "options": [
        { "value": "lightbox", "label": "Open lightbox" },
        { "value": "hover", "label": "Zoom on hover" },
        { "value": "none", "label": "No zoom" }
      ],
      "default": "lightbox",
      "label": "Image zoom"
    },
    {
      "type": "select",
      "id": "media_fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain",
      "label": "Media fit"
    },
    { "type": "checkbox", "id": "constrain_to_viewport", "default": true, "label": "Constrain to viewport" },
    { "type": "checkbox", "id": "hide_variants", "default": true, "label": "Hide unselected variant media" },
    { "type": "checkbox", "id": "enable_video_looping", "default": false, "label": "Loop video" },
    { "type": "checkbox", "id": "enable_sticky_info", "default": true, "label": "Sticky info column on desktop" }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
