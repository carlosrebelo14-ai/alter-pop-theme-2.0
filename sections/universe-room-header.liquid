{{ 'universe-room.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Universe Room header. Source of truth: Wireframe 7a / 7b.
  "Franchise is the space, not a filter inside a generic catalog." Full-width
  band: eyebrow "Universe" (marigold), display heading = the franchise name,
  one editorial line, and a full-width image on the right (desktop) / behind
  the text with a bottom gradient (mobile). Enters with --motion-editorial
  (fade + scale 1.02 -> 1.00) on arrival from the Universes panel (6b) or a
  homepage universe card. Everything below the header uses --motion-transactional.

  Data: the collection this template is applied to. `heading` / `subheading` /
  `image` in the section override the collection's own title / description /
  image. Image fallback is three levels: section image, then the
  `alterpop.hero_image` metafield (wide, curated for this header), then
  `collection.image` (square, shared with the Explore Universes / mega-menu
  tiles). No Franchise/Universe field is needed here — the collection IS the
  universe.
{%- endcomment -%}

{%- liquid
  assign uroom_eyebrow = section.settings.eyebrow | default: 'Universe'
  assign uroom_heading = section.settings.heading | default: collection.title

  assign uroom_text = section.settings.subheading
  if uroom_text == blank and collection.description != blank
    assign uroom_text = collection.description | strip_html | truncate: 160
  endif

  assign uroom_image = section.settings.image | default: collection.metafields.alterpop.hero_image | default: collection.image

  # Universe Logos handoff (24/09/2026) + addenda — see CLAUDE.md. 32 of 35
  # universes have a real logo (logos/manifest.json); evangelion/gundam/
  # one-piece are deliberate fallback handles (uroom_show_mark false).
  assign uroom_logo = collection.metafields.custom.universe_logo.value
  assign uroom_credit = collection.metafields.custom.universe_credit.value
  # §2.3 addendum (24/09/2026) — single-colour logos only, reversed white on
  # the dark cover via CSS filter. Never set on a multi-colour logo.
  assign uroom_logo_mono = collection.metafields.custom.universe_logo_mono.value

  # Optical logo sizing (24/09/2026 follow-up) — one fixed box made tall
  # logos tiny (lord-of-the-rings rendered at 81x64 of a 280x64 slot) and
  # let wide ones dominate. Three shape buckets, computed offline from each
  # logo file's own aspect ratio and stored per collection since Liquid
  # can't read image dimensions off a generic_file (SVG). Unset/unrecognised
  # -> normal, per spec.
  assign uroom_logo_shape = collection.metafields.custom.universe_logo_shape.value
  case uroom_logo_shape
    when 'wide'
      assign uroom_logo_hint_w = 280
      assign uroom_logo_hint_h = 48
    when 'tall'
      assign uroom_logo_shape = 'tall'
      assign uroom_logo_hint_w = 128
      assign uroom_logo_hint_h = 96
    else
      assign uroom_logo_shape = 'normal'
      assign uroom_logo_hint_w = 240
      assign uroom_logo_hint_h = 64
  endcase

  assign uroom_logo_class = 'ap-uroom-header__logo ap-uroom-header__logo--' | append: uroom_logo_shape
  if uroom_logo_mono
    assign uroom_logo_class = uroom_logo_class | append: ' ap-uroom-header__logo--mono'
  endif
  # uroom_show_logo gates the H1's .visually-hidden (one visible name per
  # cover) and the mark-band. 24/09/2026 revision: the mark must NOT depend
  # on uroom_image — the cover's dark base layer (band + name/logo) always
  # exists, the photo is optional (see universe-room.css --no-image). An
  # earlier version required uroom_image here too, which correctly avoided
  # hiding the H1 with nothing shown (real case: Avengers, no cover image)
  # but wrongly hid the LOGO ITSELF too whenever there was no photo — fixed
  # by dropping the uroom_image requirement rather than re-adding it.
  assign uroom_show_logo = false
  if uroom_logo != blank
    assign uroom_show_logo = true
  endif
  assign uroom_show_mark = false
  if uroom_show_logo
    assign uroom_show_mark = true
  elsif uroom_credit != blank
    assign uroom_show_mark = true
  endif
-%}

<section
  class="ap-uroom-header{% if uroom_image == blank %} ap-uroom-header--no-image{% endif %}"
  aria-label="{{ uroom_heading | escape }}"
>
  <div class="ap-uroom-header__media" aria-hidden="true">
    {%- if uroom_image != blank -%}
      {{
        uroom_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '640, 960, 1280, 1600, 2000, 2400',
          class: 'ap-uroom-header__img',
          alt: ''
      }}
    {%- endif -%}
  </div>

  <div class="ap-uroom-header__scrim" aria-hidden="true"></div>

  <div class="ap-uroom-header__inner">
    <div class="ap-uroom-header__body">
      <p class="ap-uroom-header__eyebrow type-label">{{ uroom_eyebrow | escape }}</p>
      <h1 class="ap-uroom-header__heading type-display{% if uroom_show_logo %} visually-hidden{% endif %}">{{ uroom_heading | escape }}</h1>
      {%- if uroom_text != blank -%}
        <p class="ap-uroom-header__text type-body">{{ uroom_text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if uroom_show_mark -%}
      {%- comment -%}
        Franchise mark — bottom-left of the cover, per the Universe Logos
        handoff (24/09/2026) + its 24/09/2026 addendum. One visible franchise
        name per cover: when a logo is set, the H1 above goes
        `.visually-hidden` (still in the DOM/AT tree, just not painted) and
        the logo itself carries the real alt text — no text-wordmark
        fallback. With no logo, the H1 stays visible as normal and this band
        renders the credit line alone, if set.

        Mobile: a normal in-flow block after the text (`__inner` is
        bottom-aligned in the band, so it still lands flush with the true
        bottom edge) — kept in-flow on purpose so a long editorial line
        pushes the mark down instead of the mark overlapping the text.
        Desktop (>=990px, centered body with real headroom below it):
        switched to position:absolute, pinned to the header's own bottom edge
        independent of body height, matching "Same" position in the handoff's
        desktop/mobile table. Suppressed with no cover image — nothing for a
        corner mark to anchor to in the compact "no image" band.
      {%- endcomment -%}
      <div class="ap-uroom-header__mark-band">
        {%- if uroom_logo != blank -%}
          <div class="ap-uroom-header__logo-slot">
            {%- if uroom_logo.media_type == 'image' -%}
              {{
                uroom_logo
                | image_url: height: 256
                | image_tag:
                  class: uroom_logo_class,
                  alt: collection.title,
                  loading: 'lazy',
                  widths: '160, 280, 360, 560'
              }}
            {%- else -%}
              {%- comment -%}
                generic_file: SVG and other non-transformable uploads.
                Shopify doesn't run these through the image CDN pipeline, so
                render the stored file directly per the handoff (section 7).
                width/height are the shape bucket's own desktop max box, as a
                static CLS hint, not the file's real dimensions — GenericFile
                exposes neither in Liquid. The actual render is entirely
                CSS-governed (.logo--{shape} height/max-width + object-fit:
                contain here), so a same-shape placeholder is the correct
                hint regardless of the uploaded SVG's own viewBox.
              {%- endcomment -%}
              <img
                src="{{ uroom_logo.url }}"
                alt="{{ collection.title | escape }}"
                class="{{ uroom_logo_class }}"
                loading="lazy"
                width="{{ uroom_logo_hint_w }}"
                height="{{ uroom_logo_hint_h }}"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if uroom_credit != blank -%}
          <p class="ap-uroom-header__credit type-microcopy">{{ uroom_credit | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Universe Room header",
  "tag": "section",
  "class": "section-uroom-header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Universe" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (franchise name)",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Editorial line",
      "info": "Leave blank to use the collection description."
    },
    { "type": "image_picker", "id": "image", "label": "Header image", "info": "Leave blank to use the collection image." }
  ],
  "presets": [{ "name": "Universe Room header" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
