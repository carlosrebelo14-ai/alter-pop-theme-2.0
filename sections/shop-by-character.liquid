{{ 'universe-room.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Shop by Character (Universe Room). Source of truth: Wireframe 7a / 7b.
  A label + a row of CIRCULAR character thumbnails with the name below. Mobile:
  the row scrolls horizontally. Circular on purpose — it reads as "person",
  against the square product thumbnails.

  BLOQUEADO: aguarda app — the Character field. The slot reads the expected
  source: collection.metafields.alterpop.characters.value, a list of
  { title, image, url }. Each character links to its Character Page (a
  separate Catalogue Experience pattern, wireframe 9a/9b — not built here).
  Empty -> an explicit, marked empty state. NO inference of characters from
  product titles / tags.
{%- endcomment -%}

{%- liquid
  assign ap_characters = collection.metafields.alterpop.characters.value
  assign ap_characters_present = false
  if ap_characters != blank and ap_characters.size > 0
    assign ap_characters_present = true
  endif
-%}

<section class="ap-shopby ap-shopby--character" aria-labelledby="ShopByCharacter-{{ section.id }}">
  <div class="ap-shopby__inner">
    <p class="ap-shopby__label type-label" id="ShopByCharacter-{{ section.id }}">
      {{ 'sections.universe_room.shop_by_character' | t }}
    </p>

    {%- if ap_characters_present -%}
      <ul class="ap-shopby__row ap-shopby__row--avatars" role="list">
        {%- for character in ap_characters -%}
          <li class="ap-shopby__avatar-item">
            <a class="ap-shopby__avatar" href="{{ character.url | default: '#' }}">
              <span class="ap-shopby__avatar-thumb">
                {%- if character.image -%}
                  {{
                    character.image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', widths: '80, 120, 160', alt: character.title | escape
                  }}
                {%- else -%}
                  <span class="ap-shopby__avatar-ph" aria-hidden="true">{{ character.title | slice: 0, 1 }}</span>
                {%- endif -%}
              </span>
              <span class="ap-shopby__avatar-name type-caption">{{ character.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- comment -%} Explicit empty state — marked, no invented names. {%- endcomment -%}
      <div class="ap-shopby__empty" role="note">
        <ul class="ap-shopby__row ap-shopby__row--avatars ap-shopby__row--skeleton" role="list" aria-hidden="true">
          {%- for i in (1..5) -%}
            <li class="ap-shopby__avatar-item">
              <span class="ap-shopby__avatar">
                <span class="ap-shopby__avatar-thumb"><span class="ap-shopby__avatar-ph"></span></span>
                <span class="ap-shopby__avatar-name type-caption">&nbsp;</span>
              </span>
            </li>
          {%- endfor -%}
        </ul>
        <p class="ap-shopby__empty-note type-caption">
          {{ 'sections.universe_room.shop_by_character_empty' | t }}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Character",
  "tag": "section",
  "class": "section-shopby-character",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads collection.metafields.alterpop.characters (list of character metaobjects: title, image, url). Shows a marked empty state until that field exists."
    }
  ],
  "presets": [{ "name": "Shop by Character" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
