{%- comment -%}
  One row of the PDP spec sheet. With a blank value the row renders nothing
  (2026-09-15 briefing, section 2 — no "[ pending ]" placeholder).
  Accepts: label (text, or an i18n key when i18n:true), value, i18n (Boolean).
{%- endcomment -%}
{%- if value != blank -%}
  {%- liquid
    if i18n
      assign label_text = label | t
    else
      assign label_text = label
    endif
  -%}
  <div class="ap-pdp__spec-row">
    <dt class="ap-pdp__spec-label type-caption">{{ label_text }}</dt>
    <dd class="ap-pdp__spec-value type-body">{{ value | escape }}</dd>
  </div>
{%- endif -%}
