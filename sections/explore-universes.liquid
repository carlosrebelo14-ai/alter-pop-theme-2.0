{{ 'homepage.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Alterpop — Explore Universes. Source: Wireframe_Alterpop_3_3.pdf 1a / 1b.
  Grid of doorways: 1:1 image with the franchise NAME OVERLAID at the bottom
  (white, on a dark gradient) — NOT below the tile. NOT brand logos, NOT
  product cards. Entrance: --motion-editorial.
  Wireframe 1a/1b: ONE row — mobile is a horizontal scroll strip (next tile
  peeking to signal there's more), desktop is a single 4-column row. Never a
  multi-row grid on the homepage (2026-09-16 review, correction 3) — that's
  what /collections (templates/list-collections.json, correction 4) is for.

  Source, in order of precedence (same three-way source as the header's
  universes strip / mobile drawer):
  1. shop.metafields.alterpop.universes.value — the app-populated list,
     each item { title, url, image }. Written by the sync app after each
     collectionCreate; takes over automatically once populated.
  2. section setting `universe_collections` (collection_list) — an
     explicit merchant pick of real collections. Not inference: the
     merchant names the collections directly in the theme editor, same as
     any other Dawn collection-list section setting.
  3. collections | where: 'template_suffix', 'universe-room' — every
     collection using the universe-room template, auto-discovered when
     neither of the above is set. Reads the contract each universe is
     already tagged with (templateSuffix), not inference. NOTE: the global
     `collections` object is capped at 50 items by Liquid; if the store
     ever exceeds that, this source silently misses the overflow — revisit
     with a paginated `collections_query` or keep the metafield/manual
     sources current if the catalog grows past it.
     ACTIVE SOURCE (2026-09-24): this is the source currently serving both
     live and staging — `universe_collections` is deliberately empty in
     all three instances (header, homepage, /collections) and the
     metafield doesn't exist yet. Populating either source 1 or source 2
     again takes back precedence automatically; no code change needed.
  No placeholder branch (2026-09-16 review, correction 1): with neither
  source set, or every sourced universe at 0 products, the section renders
  nothing rather than inventing franchise names the store doesn't carry.

  `max_tiles` (correction 3) caps how many tiles render — universes with
  0 products never count against it, so the limit always applies to what's
  actually shown. When there are more visible universes than `max_tiles`,
  the head shows "View All Universes ->" (same pattern as product-rail.liquid's
  "Shop All", reusing the header drawer's existing view_all_universes key) so
  the ones cut from the row still have an entry point. `show_view_all` lets
  the merchant hide it (e.g. on the /collections instance, correction 4,
  which already shows every universe and sets show_view_all: false).

  This section also powers templates/list-collections.json's "All Universes"
  page (correction 4, 2026-09-16 review) — replacing Dawn's generic
  main-list-collections there, which showed every collection including
  new-arrivals and the-mandalorian Line. On that template the section gets
  an `ap-doorways--index` modifier (keyed on template.name, not a setting —
  it's a page-identity difference, not a per-instance choice) so the grid
  stays multi-row at every width instead of the homepage's one-row/scroll
  treatment.
{%- endcomment -%}

{%- liquid
  assign ap_universes = shop.metafields.alterpop.universes.value
  assign ap_universes_from_collections = false

  if ap_universes == blank and section.settings.universe_collections.size > 0
    assign ap_universes_from_collections = true
    assign ap_collections_list = section.settings.universe_collections
  elsif ap_universes == blank
    assign ap_auto = collections | where: 'template_suffix', 'universe-room' | sort: 'title'
    if ap_auto.size > 0
      assign ap_universes_from_collections = true
      assign ap_collections_list = ap_auto
    endif
  endif

  assign max_tiles = section.settings.max_tiles

  assign ap_visible_count = 0
  if ap_universes_from_collections
    for collection in ap_collections_list
      unless collection.products_count == 0
        assign ap_visible_count = ap_visible_count | plus: 1
      endunless
    endfor
  elsif ap_universes != blank
    for universe in ap_universes
      unless universe.products_count == 0
        assign ap_visible_count = ap_visible_count | plus: 1
      endunless
    endfor
  endif

  assign ap_show_view_all = false
  if section.settings.show_view_all and ap_visible_count > max_tiles
    assign ap_show_view_all = true
  endif
-%}

{%- if ap_visible_count > 0 -%}
<section class="ap-doorways{% if template.name == 'list-collections' %} ap-doorways--index{% endif %}">
  <div class="ap-doorways__inner">
    <div class="ap-doorways__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="ap-section-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if ap_show_view_all -%}
        <a class="ap-btn ap-btn--ghost ap-doorways__viewall" href="{{ routes.collections_url }}">
          {{- 'sections.header.view_all_universes' | t }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <ul class="ap-doorways__list" role="list">
      {%- if ap_universes_from_collections -%}
        {%- assign ap_shown_count = 0 -%}
        {%- for collection in ap_collections_list -%}
          {%- if ap_shown_count >= max_tiles -%}{%- break -%}{%- endif -%}
          {%- if collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
          <li class="ap-doorways__item">
            <a class="ap-doorways__tile" href="{{ collection.url }}">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', class: 'ap-doorways__img', sizes: '(min-width: 750px) 25vw, 50vw', widths: '320, 480, 640', alt: collection.title | escape }}
              {%- else -%}
                <span class="ap-doorways__ph" aria-hidden="true">{{ collection.title | slice: 0, 1 }}</span>
              {%- endif -%}
              <span class="ap-doorways__name">{{ collection.title | escape }}</span>
            </a>
          </li>
          {%- assign ap_shown_count = ap_shown_count | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign ap_shown_count = 0 -%}
        {%- for universe in ap_universes -%}
          {%- if ap_shown_count >= max_tiles -%}{%- break -%}{%- endif -%}
          {%- if universe.products_count == 0 -%}{%- continue -%}{%- endif -%}
          <li class="ap-doorways__item">
            <a class="ap-doorways__tile" href="{{ universe.url }}">
              {%- if universe.image -%}
                {{ universe.image | image_url: width: 640 | image_tag: loading: 'lazy', class: 'ap-doorways__img', sizes: '(min-width: 750px) 25vw, 50vw', widths: '320, 480, 640', alt: universe.title | escape }}
              {%- else -%}
                <span class="ap-doorways__ph" aria-hidden="true">{{ universe.title | slice: 0, 1 }}</span>
              {%- endif -%}
              <span class="ap-doorways__name">{{ universe.title | escape }}</span>
            </a>
          </li>
          {%- assign ap_shown_count = ap_shown_count | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Explore Universes",
  "tag": "section",
  "class": "section-explore-universes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Universes" },
    {
      "type": "collection_list",
      "id": "universe_collections",
      "label": "Universe collections",
      "info": "Explicit merchant curation, used until shop.metafields.alterpop.universes exists — the app-populated metafield takes over automatically once it does.",
      "limit": 50
    },
    {
      "type": "range",
      "id": "max_tiles",
      "min": 4, "max": 50, "step": 1, "default": 4,
      "label": "Maximum tiles shown",
      "info": "Universes with 0 products never count toward this limit. On the homepage this should stay a single row (4); the /collections instance sets it to show every universe."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View All Universes\" link past the tile limit",
      "default": true
    }
  ],
  "presets": [{ "name": "Explore Universes" }]
}
{% endschema %}
